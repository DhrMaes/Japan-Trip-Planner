<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Automatically build the React app during local dev before building the server -->
  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(BuildingInsideDocker)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="../JapanTripPlanner.App" ContinueOnError="true" />
  </Target>

</Project>
