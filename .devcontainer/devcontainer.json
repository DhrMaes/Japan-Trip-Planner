{
  "name": "Japan Trip Planner (.NET 10 & Web Dev)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8096, 5173],
  "portsAttributes": {
    "8096": {
      "label": "Japan Trip Planner Web Server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite Dev Server (Frontend HMR)",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=japantripplanner-server-bin,target=${containerWorkspaceFolder}/src/JapanTripPlanner.Server/bin,type=volume",
    "source=japantripplanner-server-obj,target=${containerWorkspaceFolder}/src/JapanTripPlanner.Server/obj,type=volume",
    "source=japantripplanner-app-nodemodules,target=${containerWorkspaceFolder}/src/JapanTripPlanner.App/node_modules,type=volume"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "JapanTripPlanner.slnx",
        "omnisharp.enableRoslynAnalyzers": true,
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "files.trimTrailingWhitespace": true
      },
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker",
        "ritwickdey.liveserver",
        "formulahendry.auto-rename-tag",
        "esbenp.prettier-vscode",
        "bierner.markdown-preview-github-styles"
      ]
    }
  },
  "updateContentCommand": "sudo chown -R vscode:vscode src/JapanTripPlanner.Server/bin src/JapanTripPlanner.Server/obj src/JapanTripPlanner.App/node_modules",
  "postCreateCommand": "sudo chown -R vscode:vscode src/JapanTripPlanner.Server/bin src/JapanTripPlanner.Server/obj src/JapanTripPlanner.App/node_modules && dotnet restore JapanTripPlanner.slnx && cd src/JapanTripPlanner.App && npm install && npm run build",
  "postStartCommand": "sudo chown -R vscode:vscode src/JapanTripPlanner.Server/bin src/JapanTripPlanner.Server/obj src/JapanTripPlanner.App/node_modules",
  "remoteUser": "vscode"
}
